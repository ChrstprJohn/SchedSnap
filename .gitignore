coverage/

# Cloudinary originals stay local; commit their delivery manifest and presets.
/public/wallpapers/
/public/images/mascots/masters/
/public/images/pixel-mascots/masters/
/public/images/goofy-mascots/masters/
/public/images/doodle-mascots/masters/

# Keep full-resolution landing PNGs local; commit responsive delivery images.
/public/images/collections/catalog-mobile/*.png
/public/images/collections/refreshed/**/*.png
/public/images/hero/hero-phones-*.png
/public/images/maker/maker-capybara-static.png

# Generated source artwork and visual review captures.
/output/**/*.png
/output/**/*.webp
/output/**/*.jpg
/output/**/*.jpeg
/.impeccable/**/*.png
/.impeccable/**/*.webp
/.impeccable/**/*.jpg
/.impeccable/**/*.jpeg
/documentation/**/*.png
/documentation/**/*.webp
/documentation/**/*.jpg
/documentation/**/*.jpeg
/src/assets/*.upload-tmp
/output/cloudinary-upload-*.json

# Local scratch work, generated reports, and artwork download bundles.
/tmp/
/.worktrees/
/*.b64
/tmp-*
/output/**/*.txt
/output/**/*.zip
/output/**/*.tar
/output/**/*.tar.gz
/output/genshin/drafts/
/output/genshin-backgrounds/drafts/
