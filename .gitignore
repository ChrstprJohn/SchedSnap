node_modules/
dist/
.vercel/
.env
.env.*
!.env.example
*.local
*.log
coverage/

# Cloudinary originals stay local; commit their delivery manifest and presets.
/public/wallpapers/**/*.png
# Keep the reviewed local Snoopy previews available on branch checkouts.
!/public/wallpapers/scenic/snoopy-*/mobile.png
!/public/wallpapers/scenic/snoopy-*/tablet.png
!/public/wallpapers/scenic/snoopy-*/laptop.png
/public/images/mascots/masters/*.png
/public/images/pixel-mascots/masters/*.png
/public/images/goofy-mascots/masters/*.png
/public/images/doodle-mascots/masters/*.png

# Generated source artwork and visual review captures.
/output/**/*.png
/output/**/*.webp
/output/**/*.jpg
/output/**/*.jpeg
/.impeccable/**/*.png
/.impeccable/**/*.webp
/.impeccable/**/*.jpg
/.impeccable/**/*.jpeg
/documentation/**/*.png
/documentation/**/*.webp
/documentation/**/*.jpg
/documentation/**/*.jpeg
/src/assets/*.upload-tmp
/output/cloudinary-upload-*.json

# Local scratch work, generated reports, and artwork download bundles.
/tmp/
/output/**/*.txt
/output/**/*.zip
/output/**/*.tar
/output/**/*.tar.gz
/output/genshin/drafts/
/output/genshin-backgrounds/drafts/
/output/**/*-deployments.json

# Python caches from artwork utilities.
__pycache__/
*.py[cod]
