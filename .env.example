# Server only. Set these in Vercel project environment settings for deployment.
# Copy to .env.local for local development; never commit your real key.
# Do not prefix this key with VITE_: that would expose it to the browser.
GEMINI_API_KEY=
# Configurable for the future extraction implementation. Verify account access.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional aggregate homepage visit counter. Server-only Redis REST credentials.
# Leave empty to display an unavailable count instead of invented visits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public PostHog project token, never a personal or secret API key.
# Use the same project as Celestial; events are tagged site_name: schedsnap.
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
